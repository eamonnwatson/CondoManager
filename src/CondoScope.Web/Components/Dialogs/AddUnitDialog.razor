<EditForm Model="@newUnit" OnValidSubmit="CreateUnit">
    <DataAnnotationsValidator />
    <MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add Unit</MudText>
    </TitleContent>
    <DialogContent>

            <MudTextField Label="Unit Number" 
                          @bind-Value="newUnit.UnitNumber" 
                          Variant="Variant.Outlined" 
                          For="@(() => newUnit.UnitNumber)" />

            <MudTextField Label="Address" 
                          @bind-Value="newUnit.Address" 
                          Variant="Variant.Outlined" 
                          For="@(() => newUnit.Address)" />

    </DialogContent>
    <DialogActions>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Add</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private AddUnitFormModel newUnit = new AddUnitFormModel();

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void CreateUnit(EditContext context)
    {
        MudDialog.Close(DialogResult.Ok(newUnit));
    }

}
