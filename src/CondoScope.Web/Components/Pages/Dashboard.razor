@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

<MudGrid class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Total Units</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h3" Align="Align.Center">@ledgerCount</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Collected</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h3" Align="Align.Center">@totalCollected.ToString("C2")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Outstanding</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h3" Align="Align.Center">@totalFees.ToString("C2")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Collection %</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h3" Align="Align.Center">@collectionPercentage.ToString("P2")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudGrid class="d-flex align-stretch mb-4">

    <MudItem xs="12" sm="6" Class="d-flex">
        <MudCard class="d-flex flex-column flex-grow-1 h-100">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Collection Status</MudText>
            </MudCardHeader>
            <MudCardContent>
                <MudChart T="decimal" 
                          ChartType="ChartType.Pie" 
                          ChartLabels="ChartLabels" 
                          ChartSeries="ChartValues.AsChartDataSet()" 
                          Width="100%" Height="300px" 
                          ChartOptions="chartOptions" />
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" Class="d-flex">
        <MudCard class="d-flex flex-column flex-grow-1 h-100">
            <MudCardHeader>
                <MudText Typo="Typo.h6">Charges Assessed</MudText>
            </MudCardHeader>
            <MudCardContent Class="d-flex">
                <MudSimpleTable Elevation="0" Class="no-border-table align-self-center flex-grow-1">
                    <tbody>
                        <tr>
                            <td>Monthly Charges</td>
                            <td class="text-right">@ledger.Sum(l => l.CondoFees).ToString("C2")</td>
                        </tr>
                        <tr>
                            <td>Reserve Charges</td>
                            <td class="text-right">@ledger.Sum(l => l.ReserveFund).ToString("C2")</td>
                        </tr>
                        <tr>
                            <td>Other Charges</td>
                            <td class="text-right">@ledger.Sum(l => l.OtherCharges).ToString("C2")</td>
                        </tr>
                        <tr>
                            <td style="font-size:20px;font-weight:bold;border-top: 4px solid #2563EB;">Total Charges</td>
                            <td class="text-right" style="font-size:20px;font-weight:bold;border-top: 4px solid #2563EB;">@ledger.Sum(l => l.CondoFees + l.ReserveFund + l.OtherCharges).ToString("C2")</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudCardContent>
        </MudCard>
    </MudItem>

</MudGrid>

<MudCard>
    <MudCardHeader>
        <MudText Typo="Typo.h6">Owner Payment Status</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudSimpleTable Elevation="0">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th class="text-right">Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var owner in ledger)
                {
                    <tr>
                        <td>@owner.UnitNumber</td>
                        <td>@owner.OwnerName</td>
                        <td><MudChip T="string" Color="@GetColor(owner.AccountStatus)">@GetAccountStatus(owner.AccountStatus)</MudChip></td>
                        <td class="text-right">@owner.Balance.ToString("C2")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>
