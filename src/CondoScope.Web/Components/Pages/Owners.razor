@page "/owners"

<MudCard>
    <MudCardHeader Class="primary-card">
        <CardHeaderContent>
            <MudText Typo="Typo.h4">Owners</MudText>
            <MudText Typo="Typo.body1">Manage owner contact information for all condominium owners.</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Success" OnClick="OpenCreateDialog">Add Owner</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2" Class="pb-1">Showing @owners.Count owners</MudText>

        <MudDataGrid Items="owners" Elevation="0" Class="primary-table" SortMode="SortMode.None">
            <Columns>
                <PropertyColumn Property="x => x.UnitNumber" Title="Unit" />
                <PropertyColumn Property="x => x.Name" Title="Owner" />
                <PropertyColumn Property="x => x.Address" Title="Address" />
                <PropertyColumn Property="x => x.Email.ToString()" Title="Email" />
                <TemplateColumn Title="Phone">
                    <CellTemplate>
                        @FormatPhoneNumber(context.Item.PhoneNumber)
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>

    </MudCardContent>
</MudCard>
