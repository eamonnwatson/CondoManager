@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

<MudGrid class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Total Units</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h5">@ledgerCount</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Collected</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h5">@totalCollected.ToString("C2")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Outstanding</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h5">@totalFees.ToString("C2")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard>
            <MudCardHeader Class="dashboard-card-header-info">
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Collection %</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.h5">@collectionPercentage.ToString("P2")</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudGrid class="mb-4">

    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Collection Status</MudText>
            <MudChart T="decimal" ChartType="ChartType.Pie" ChartLabels="chartLabels" ChartSeries="chartValues.AsChartDataSet()" Width="100%" Height="300px" ChartOptions="chartOptions" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h6">Charges Assessed</MudText>
            <MudSimpleTable Elevation="0">
                <tbody>
                    <tr>
                        <td>Monthly Charges</td>
                        <td>@ledger.Sum(l => l.CondoFees).ToString("C2")</td>
                    </tr>
                    <tr>
                        <td>Reserve Charges</td>
                        <td>@ledger.Sum(l => l.ReserveFund).ToString("C2")</td>
                    </tr>
                    <tr>
                        <td>Other Charges</td>
                        <td>@ledger.Sum(l => l.OtherCharges).ToString("C2")</td>
                    </tr>
                    <tr>
                        <td>Total Charges</td>
                        <td>@ledger.Sum(l => l.CondoFees + l.ReserveFund + l.OtherCharges).ToString("C2")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>

</MudGrid>

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6">Owner Payment Status</MudText>
    <MudSimpleTable Elevation="0">
        <thead>
            <tr>
                <th>Unit</th>
                <th>Owner</th>
                <th>Status</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var owner in ledger)
            {
                <tr>
                    <td>@owner.UnitNumber</td>
                    <td>@owner.OwnerName</td>
                    <td>@owner.AccountStatus</td>
                    <td>@owner.Balance.ToString("C2")</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>
