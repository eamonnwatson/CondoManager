@page "/fee-schedule"

<MudCard>
    <MudCardHeader Class="primary-card">
        <CardHeaderContent>
            <MudText Typo="Typo.h4">Fee Schedule</MudText>
            <MudText Typo="Typo.body1">Configure recurring condo fees and special assessments.</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Success" OnClick="OpenCreateDialog">Add Fee Charge</MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudText Typo="Typo.body2" Class="pb-1">Showing @feeCharges.Count fee charges</MudText>

        <MudDataGrid Items="feeCharges" Elevation="0" Class="primary-table">
            <Columns>
                <PropertyColumn Property="x => x.DueDate" Title="Due Date" InitialSortDirection="SortDirection.Descending" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => x.Category" Title="Category" />
                <PropertyColumn Property="x => GetAppliesToString(x)" Title="Applies To" />
                <PropertyColumn Property="x => x.Amount" Title="Amount" Format="C2" CellClass="text-right" />
            </Columns>
            <PagerContent>
                <MudDataGridPager />
            </PagerContent>
        </MudDataGrid>

    </MudCardContent>
</MudCard>

